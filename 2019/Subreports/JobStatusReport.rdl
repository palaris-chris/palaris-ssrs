    <DataSet Name="WIPAgedDays">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SELECT 
DATEADD(DAY, -AgedDays, GETDATE()) AS [Date]
,[AgedDays]
,[WIP] AS [Uninvoiced]
,[WIPNoPO] AS [UninvoicedNoPO]

FROM
[Production].[vw_qry_JobDetail]
WHERE
[Job No] = @JobNo_</CommandText>
      </Query>
      <Fields>
        <Field Name="Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Date</DataField>
        </Field>
        <Field Name="AgedDays">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>AgedDays</DataField>
        </Field>
        <Field Name="Uninvoiced">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>Uninvoiced</DataField>
        </Field>
        <Field Name="UninvoicedNoPO">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>UninvoicedNoPO</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ActiveJobs">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SELECT *
FROM
[Production].[vw_qry_JobDetail]
WHERE
[Job No] = @JobNo_</CommandText>
      </Query>
      <Fields>
        <Field Name="DB">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DB</DataField>
        </Field>
        <Field Name="Database">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Database</DataField>
        </Field>
        <Field Name="Job_No">
