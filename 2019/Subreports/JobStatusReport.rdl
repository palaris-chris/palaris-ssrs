    <DataSet Name="JobComments">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

WITH LastCET AS (
    SELECT TOP 1
        cl.[Date],
        cl.Code,
        cl.Comment,
        cl.[No_]
    FROM [Production].[vw_tbl_CommentLine] cl
    WHERE
        cl.[Table Name] = 5
        AND cl.Code LIKE 'INV%'
        AND cl.[No_] = @JobNo_
        AND cl.Comment LIKE '%CET%V%'
    ORDER BY cl.[Date] DESC
),
FirstCET AS (
    SELECT TOP 1
        cl.[Date],
        cl.Code,
        cl.Comment,
        cl.[No_]
    FROM [Production].[vw_tbl_CommentLine] cl
    WHERE
        cl.[Table Name] = 5
        AND cl.Code LIKE 'INV%'
        AND cl.[No_] = @JobNo_
        AND cl.Comment LIKE '%CET%V%'
	AND cl.Comment != (SELECT Comment FROM LastCET)
    ORDER BY cl.[Date] ASC
),

OtherComments AS (
    SELECT
        cl.[Date],
        cl.Code,
        cl.Comment,
        cl.[No_]
    FROM [Production].[vw_tbl_CommentLine] cl
    WHERE
        cl.[Table Name] = 5
        AND cl.Code LIKE 'INV%'
        AND cl.[No_] = @JobNo_
        AND cl.Comment NOT LIKE '%CET%V%'
)

SELECT *
FROM OtherComments
UNION ALL
SELECT *
FROM LastCET
UNION ALL
SELECT *
FROM FirstCET
ORDER BY [Date] DESC;</CommandText>
      </Query>
      <Fields>
        <Field Name="Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Date</DataField>
        </Field>
        <Field Name="Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Code</DataField>
        </Field>
        <Field Name="Comment">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Comment</DataField>
        </Field>
        <Field Name="No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>No_</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Subconts">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

WITH SUBCONTRCT_JPL AS (
      SELECT
        jpl.[Job No_],
		jpl.[Line No_] AS [LineID],
  	job.[Global Dimension 2 Code] as [BU],
        jpl.[Job Task No_],
        jt.Description AS [Task],
        job.[Description],
        ven.Name AS Vendor,
	'Subcontractor' AS Resource,
        jpl.[Job Task No_] AS [Vendor No_],
        jpl.No_,
        jpl.[Quantity (Base)],
        'Schedule' AS [Type],
	jpl.[Work Type Code],
        jpl.[Unit Cost]   AS [Unit Cost],
        jpl.[Unit Price]  AS [Unit Price],
        jpl.[Total Cost]  AS [Total Cost],
        jpl.[Total Price] AS [Total Price],
        jpl.[Line Amount] AS [Line Amount]
		, jpl.[Quantity] AS ScheduleQty
		, jpl.[Total Cost] AS ScheduleTotalCost
		, jpl.[Line Amount] AS ScheduleTotalPrice
		, NULL AS UsageQty
		, NULL AS UsageTotalCost
		, NULL AS UsageTotalPrice
        ,job.Currency AS [Currency Code]		
		
      FROM
        [Production].[vw_tbl_JobPlanningLine] jpl

        LEFT JOIN [Production].[vw_qry_JobDetail] job ON jpl.[Job No_] = job.[Job No] AND job.[DB] = jpl.[DB]
        LEFT JOIN [Production].[vw_tbl_JobTask] jt ON jpl.[Job Task No_] = jt.[Job Task No_] AND jpl.[Job No_] = jt.[Job No_] AND jt.[DB] = jpl.[DB]

        LEFT JOIN [Production].[vw_tbl_Vendor] ven on jpl.[Job Task No_] = ven.No_ AND jpl.[DB] = ven.[DB]

      WHERE jpl.[Work Type Code] NOT LIKE 'OSA%'
            AND jpl.[Work Type Code] NOT LIKE 'KM%'
            AND jpl.[No_] IN ('51150', '51160')
			AND jpl.[Line Type] = 0
	    AND jpl.[Job No_] = @JobNo_
  ),

  SUBCONSULT_JPL AS (
      SELECT
        jpl.[Job No_],
		jpl.[Line No_] AS [LineID],
        job.[Global Dimension 2 Code] as [BU],
        jpl.[Job Task No_],
        jt.Description AS [Task],
        job.[Description],
        ven.Name AS Vendor,
	res.Name AS Resource,
        res.[Vendor No_],
        jpl.No_,
        jpl.[Quantity (Base)],
        'Schedule' AS [Type],
	jpl.[Work Type Code],
        jpl.[Unit Cost]   AS [Unit Cost],
        jpl.[Unit Price]  AS [Unit Price],
        jpl.[Total Cost]  AS [Total Cost],
        jpl.[Total Price] AS [Total Price],
        jpl.[Line Amount] AS [Line Amount]
		, jpl.[Quantity] AS ScheduleQty
		, jpl.[Total Cost] AS ScheduleTotalCost
		, jpl.[Line Amount] AS ScheduleTotalPrice
		, NULL AS UsageQty
		, NULL AS UsageTotalCost
		, NULL AS UsageTotalPrice
        ,job.Currency AS [Currency Code]		
      FROM
        [Production].[vw_tbl_JobPlanningLine] jpl

        LEFT JOIN [Production].[vw_qry_JobDetail] job ON jpl.[Job No_] = job.[Job No] AND job.[DB] = jpl.[DB]
        LEFT JOIN [Production].[vw_tbl_JobTask] jt ON jpl.[Job Task No_] = jt.[Job Task No_] AND jpl.[Job No_] = jt.[Job No_] AND jt.[DB] = jpl.[DB]
        LEFT JOIN [Production].[vw_tbl_Resource] res ON jpl.[No_] = res.[No_] AND res.[DB] = jpl.[DB]
        LEFT JOIN [Production].[vw_tbl_Vendor] ven on res.[Vendor No_] = ven.No_ AND res.[DB] = ven.[DB]

      WHERE jpl.[Work Type Code] NOT LIKE 'OSA%'
            AND jpl.[Work Type Code] NOT LIKE 'KM%'
            AND (LEFT(jpl.No_, 2) IN ('R9','S0') AND jpl.No_ &lt;&gt; 'R9998')
			AND jpl.[Line Type] = 0
            AND jpl.[Job No_] = @JobNo_
  ),

  SUBCONTRCT_JLE AS (
      SELECT
        jle.[Job No_],
		jle.[Entry No_] AS [LineID],
  	job.[Global Dimension 2 Code] as [BU],
        jle.[Job Task No_],
        jt.Description AS [Task],
        job.[Description],        
	ven.Name AS Vendor,
	'Subcontractor' AS Resource,
        jle.[Job Task No_] AS [Vendor No_],
        jle.No_,
        jle.[Quantity (Base)],
        'Usage' AS [Type],
	jle.[Work Type Code],
        jle.[Unit Cost]   AS [Unit Cost],
        jle.[Unit Price]  AS [Unit Price],
        jle.[Total Cost]  AS [Total Cost],
        jle.[Total Price] AS [Total Price],
        jle.[Line Amount] AS [Line Amount]
		, NULL AS ScheduleQty
		, NULL AS ScheduleTotalCost
		, NULL AS ScheduleTotalPrice
		, jle.[Quantity] AS UsageQty
		, jle.[Total Cost] AS UsageTotalCost
		, jle.[Line Amount] AS UsageTotalPrice
        ,job.Currency AS [Currency Code]		        
      FROM
        [Production].[vw_tbl_JobLedgerEntry] jle

        LEFT JOIN [Production].[vw_qry_JobDetail] job ON jle.[Job No_] = job.[Job No] AND job.[DB] = jle.[DB]
        LEFT JOIN [Production].[vw_tbl_JobTask] jt ON jle.[Job Task No_] = jt.[Job Task No_] AND jle.[Job No_] = jt.[Job No_] AND jt.[DB] = jle.[DB]

        LEFT JOIN [Production].[vw_tbl_Vendor] ven on jle.[Job Task No_] = ven.No_ AND jle.[DB] = ven.[DB]


      WHERE jle.[Work Type Code] NOT LIKE 'OSA%'
            AND jle.[Work Type Code] NOT LIKE 'KM%'
            AND jle.[No_] IN ('51150', '51160')
				AND jle.[Job No_] = @JobNo_
 	AND jle.[Entry Type] = 0
  ),

  SUBCONSULT_JlE AS (
      SELECT
        jle.[Job No_],
		jle.[Entry No_] AS [LineID],
  	job.[Global Dimension 2 Code] as [BU],
        jle.[Job Task No_],
        jt.Description AS [Task],
        job.[Description],
        ven.Name AS Vendor,
	res.Name AS Resource,
        res.[Vendor No_],
        jle.No_,
        jle.[Quantity (Base)],
        'Usage' AS [Type],
	jle.[Work Type Code],
        jle.[Unit Cost]   AS [Unit Cost],
        jle.[Unit Price]  AS [Unit Price],
        jle.[Total Cost]  AS [Total Cost],
        jle.[Total Price] AS [Total Price],
        jle.[Line Amount] AS [Line Amount]
		, NULL AS ScheduleQty
		, NULL AS ScheduleTotalCost
		, NULL AS ScheduleTotalPrice
		, jle.[Quantity] AS UsageQty
		, jle.[Total Cost] AS UsageTotalCost
		, jle.[Line Amount] AS UsageTotalPrice
        , job.Currency AS [Currency Code]		        
      FROM
        [Production].[vw_tbl_JobLedgerEntry] jle

        LEFT JOIN [Production].[vw_qry_JobDetail] job ON jle.[Job No_] = job.[Job No] AND job.[DB] = jle.[DB]
        LEFT JOIN [Production].[vw_tbl_JobTask] jt ON jle.[Job Task No_] = jt.[Job Task No_] AND jle.[Job No_] = jt.[Job No_] AND jt.[DB] = jle.[DB]
        LEFT JOIN [Production].[vw_tbl_Resource] res ON jle.[No_] = res.[No_] AND res.[DB] = jle.[DB]
        LEFT JOIN [Production].[vw_tbl_Vendor] ven on res.[Vendor No_] = ven.No_ AND res.[DB] = ven.[DB]

      WHERE jle.[Work Type Code] NOT LIKE 'OSA%'
            AND jle.[Work Type Code] NOT LIKE 'KM%'
            AND (LEFT(jle.No_, 2) IN ('R9','S0') AND jle.No_ &lt;&gt; 'R9998')
            AND jle.[Job No_] = @JobNo_
  AND jle.[Entry Type] = 0
  ),

JLE_JPL AS (
    SELECT *
    FROM SUBCONTRCT_JPL
    UNION
    SELECT *
    FROM SUBCONSULT_JPL
    UNION
    SELECT *
    FROM SUBCONTRCT_JLE
    UNION
    SELECT *
    FROM SUBCONSULT_JLE
  )

SELECT * FROM JLE_JPL</CommandText>
      </Query>
