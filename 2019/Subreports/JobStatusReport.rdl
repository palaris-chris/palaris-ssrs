          <DataField>Contract</DataField>
        </Field>
        <Field Name="ContractQty">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>ContractQty</DataField>
        </Field>
        <Field Name="ContractQtyExp">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>ContractQtyExp</DataField>
        </Field>
        <Field Name="JPNameShortClean">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JPNameShortClean</DataField>
        </Field>
        <Field Name="JPShortInitial">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JPShortInitial</DataField>
        </Field>
      </Fields>
      <Filters>
        <Filter>
          <FilterExpression>=Fields!Line_Type.Value</FilterExpression>
          <Operator>In</Operator>
          <FilterValues>
            <FilterValue>=CStr("Contract,Schedule").Split(",")</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="Currency">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SELECT 
    COALESCE(j.[Currency], 'AUD') AS [Currency Code]
FROM (SELECT 1 AS dummy) d
OUTER APPLY (
    SELECT TOP 1 [Currency]
    FROM [Production].[vw_qry_JobDetail]
    WHERE [Job No] = @JobNo_
) j;</CommandText>
      </Query>
      <Fields>
        <Field Name="Currency_Code">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Currency Code</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
