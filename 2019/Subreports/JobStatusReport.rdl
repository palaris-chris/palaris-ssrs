      <Filters>
        <Filter>
          <FilterExpression>=Fields!Job_No.Value</FilterExpression>
          <Operator>Equal</Operator>
          <FilterValues>
            <FilterValue>=Parameters!JobNo_.Value</FilterValue>
          </FilterValues>
        </Filter>
      </Filters>
    </DataSet>
    <DataSet Name="JPLContract">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;

WITH 

CreditNotes AS
(
SELECT DISTINCT [Document No_]
FROM [Production].[vw_tbl_JobPlanningLineInvoice]
WHERE [Job No_] = @JobNo_
AND [Document No_] LIKE 'CR%'
)
,

AppliesTo AS
(

SELECT DISTINCT [Applies-to Doc_ No_]
FROM [Production].[vw_tbl_SalesCrMemoHeader]
WHERE No_ IN (SELECT * FROM CreditNotes)
),

JobTasks AS
(
SELECT 
jt.[DB]
,jt.[Job No_]
, jt.[Job Task No_]
, jt.Description AS [Name]
, jt.Indentation
, CASE WHEN [Job Task Type] = 0 THEN 'Posting'
WHEN [Job Task Type] = 1 THEN 'Heading'
WHEN [Job Task Type] = 2 THEN 'Total'
WHEN [Job Task Type] = 3 THEN 'Begin-Total'
WHEN [Job Task Type] = 4 THEN 'End-Total'
END AS [Job Task Type]

FROM [Production].[vw_tbl_JobTask] jt
WHERE jt.[Job No_] = @JobNo_
AND jt.[Job Task Type] = 0 
),

JPL AS 
(
SELECT 
jpl.[Job No_]
,jpl.[Job Task No_]
,CONCAT(jpl.[Job No_],jpl.[Job Task No_]) AS [JobTaskNo]
,jt.[Name] AS [Task]
,CASE  WHEN jpl.[Line Type] = '0' THEN 'Schedule'
    WHEN jpl.[Line Type] = '1' THEN 'Contract'
    END AS [Line Type]
,jpl.No_ 
,jpl.[Planning Date] AS DATE
,jpl.[Document Date]
,FORMAT([Planning Date],'MMM yy') AS [Month-Year]
,DATEPART(isoww, [Planning Date]) AS [ISO-Week]
,YEAR(DATEADD(day, 26 - DATEPART(isoww,[Planning Date]), [Planning Date])) AS [ISO-Week-Year]
,CASE WHEN jpl.Type = '2' THEN ac.[Name]
    WHEN jpl.Type = '0' THEN res.[Name]
    END AS Name
,CASE WHEN jpl.Type = '2' THEN 'Expenses'
    WHEN jpl.Type = '0' THEN res.[Search Name]
    END AS NameShort
,CASE WHEN jpl.Type = '2' THEN 'Expenses'
WHEN jpl.[Work Type Code] LIKE 'KM%' OR jpl.[Work Type Code] LIKE 'OSA' THEN 'Expenses'
    WHEN jpl.Type = '0' THEN (SELECT TOP 1 jrp.[Job Position Title] 
    FROM [Production].[vw_qry_ProjectResourcePrice] jrp WHERE jrp.[Job No_] = @JobNo_ AND jrp.[Code] = jpl.[No_] AND jrp.[DB] = jpl.[DB]) 
    END AS JPNameShort
,CASE WHEN jpl.[Expense No_ Allocation] IN ('52100', '52400', '52500', '52600') THEN ac.[Name]
    WHEN jpl.[Expense No_ Allocation] IN ('52115','52150') THEN 'Travel'
    WHEN jpl.[Work Type Code] LIKE 'KM%' THEN 'Travel'
    WHEN jpl.[Work Type Code] LIKE 'OSA%' THEN 'Meals'
    WHEN jpl.Type = '2' THEN 'Other Costs'
    WHEN jpl.[Job Position Title] = '' THEN (SELECT TOP 1 jrp.[Job Position Title] 
    FROM [Production].[vw_qry_ProjectResourcePrice] jrp WHERE jrp.[Job No_] = @JobNo_ AND jrp.[Code] = jpl.[No_] AND jrp.[DB] = jpl.[DB]) 
    WHEN jpl.Type = '0' THEN jpl.[Job Position Title] 
    END AS JPName
,CASE WHEN jpl.[Expense No_ Allocation] = '2' THEN 'Expenses'
WHEN jpl.[Work Type Code] LIKE 'KM%' OR jpl.[Work Type Code] LIKE 'OSA%' THEN 'Expenses'
    WHEN jpl.[Type]='0' THEN jt.Name
    END AS TaskExpenses      
,CASE WHEN jpl.Type = '2' THEN 'G/L Account'
	WHEN jpl.No_ = 'R9998' THEN 'Milestone Allocation'
    WHEN jpl.Type = '0' THEN 'Resource'
    END AS Type
,jpl.[Job Position Title]    
,jpl.Description
,CONVERT(varchar(10),jpl.[Job Contract Entry No_]) AS [Document No_]
,jpl.Quantity
,jpl.[Quantity (Base)]
,jpl.[Location Code]
,jpl.[Work Type Code]
,jpl.[Unit of Measure Code] 
,jpl.[Unit Cost]
,jpl.[Total Cost]
,jpl.[Unit Price]
,jpl.[Total Price]
,jpl.[Line Discount _]
,jpl.[Line Discount Amount]
,jpl.[Line Amount]
,CASE WHEN jpl.[Qty_ to Invoice] != 0 THEN 'Uninvoiced'
    ELSE jpli.[Document No_] END AS [InvoiceNo]
    
,jpl.[Gen_ Bus_ Posting Group]
,jpl.[Gen_ Prod_ Posting Group] 
,CASE WHEN jpl.[Line Type] = '0' THEN null
WHEN jpl.[Line Type] = '1' THEN jpl.[Qty_ to Transfer to Invoice]
END AS [Qty_ to Transfer to Invoice]
,CASE WHEN jpl.[Line Type] = '0' THEN null
WHEN jpl.[Line Type] = '1' THEN jpl.[Qty_ to Invoice]
END AS [Qty_ to Invoice]
,CASE WHEN jpl.[Line Type] = '0' THEN null
    WHEN jpl.[Line Type] = '1' THEN (jpl.Quantity - jpl.[Qty_ to Invoice]) 
    END AS [Qty_ Invoiced]
,jpl.[Ledger Entry No_]
,job.[Currency]

FROM 

  [Production].[vw_tbl_JobPlanningLine] jpl
 LEFT JOIN [Production].[vw_qry_JobDetail] job ON jpl.[Job No_] = job.[Job No] AND job.[DB] = jpl.[DB]
 LEFT JOIN [Production].[vw_tbl_Resource] res ON jpl.[No_] = res.[No_] AND res.[DB] = jpl.[DB]
 LEFT JOIN [Production].[vw_tbl_GLAccount] ac ON jpl.[Expense No_ Allocation] = ac.No_  AND ac.[DB] = jpl.[DB]
 LEFT JOIN JobTasks jt ON jpl.[Job Task No_] = jt.[Job Task No_] AND jpl.[Job No_] = jt.[Job No_] AND jt.[DB] = jpl.[DB]
 LEFT JOIN [Production].[vw_tbl_JobPlanningLineInvoice] jpli ON jpl.[Job No_] = jpli.[Job No_] AND jpl.[Job Task No_] = jpli.[Job Task No_] AND jpl.[Line No_] = jpli.[Job Planning Line No_]


WHERE jpl.[Job No_] = @JobNo_
AND jpl.[Job Task No_] NOT LIKE 'X-%'
AND (jpli.[Document No_] NOT LIKE 'CR%'
AND jpli.[Document No_] NOT IN (SELECT * FROM AppliesTo)
OR jpli.[Document No_] IS NULL)

),

JPL_Pivot AS
(
SELECT *

,   CASE WHEN jpl.[Line Type] = 'Contract' AND jpl.[Qty_ to Invoice] != 0 THEN [Line Amount]
    ELSE null
    END AS [Uninvoiced]
,   CASE WHEN jpl.[Line Type] = 'Contract' AND jpl.[Qty_ to Invoice] = 0 THEN [Line Amount]
    ELSE null
    END AS [Invoiced]
,   CASE WHEN jpl.[Line Type] = 'Schedule' THEN [Line Amount]
    ELSE null
    END AS [Schedule]
,   CASE WHEN jpl.[Line Type] = 'Schedule' THEN [Quantity (Base)]
    ELSE null
    END AS [ScheduleQty]
,   CASE WHEN jpl.[Line Type] = 'Contract' THEN [Line Amount]
    ELSE null
    END AS [Contract]
,   CASE WHEN jpl.[Line Type] = 'Contract' THEN [Quantity]
    ELSE null
    END AS [ContractQty]
,   CASE WHEN jpl.[Line Type] = 'Contract' AND (jpl.[Type] = 'G/L Account' OR jpl.[Work Type Code] LIKE 'OSA%' OR jpl.[Work Type Code] LIKE 'KM%') THEN [Line Amount]
	WHEN jpl.[Line Type] = 'Contract' THEN [Quantity]
    ELSE null
    END AS [ContractQtyExp]
, REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE([JPNameShort],' - ',' '),'(',''),')',''),' &amp; ',' '),'&amp;',' '),' / ',' '),'/',' ') AS [JPNameShortClean]

 FROM JPL

)

SELECT *
,CASE 
    WHEN [JPNameShort] = 'Expenses' THEN 'Exp' 
    ELSE    
        REPLACE(
            -- First initial
            SUBSTRING([JPNameShortClean], 1, 3) +
            -- Middle/Last initial when there is no dash
            SUBSTRING([JPNameShortClean], CHARINDEX(' ', [JPNameShortClean]) + 1, 3) +
            -- Last initial
            CASE 
                WHEN 0 &lt;&gt; CHARINDEX(' ', [JPNameShortClean], CHARINDEX(' ', [JPNameShortClean]) + 1) -- More than two words 
                THEN SUBSTRING([JPNameShortClean], CHARINDEX(' ', [JPNameShortClean], CHARINDEX(' ', [JPNameShortClean]) + 1) + 1, 3)  
                ELSE '' -- Have to add an empty string to avoid NULLing the entire result
            END 
        , ' ', '')
END
AS JPShortInitial

 FROM JPL_Pivot

ORDER BY [Date] asc</CommandText>
      </Query>
      <Fields>
        <Field Name="RoleGrouping">
          <Value>=IIf(Fields!NameShort.Value = "Expenses", "Expenses", Fields!JPShortInitial.Value &amp; ROUND(Fields!Unit_Price.Value,0))</Value>
        </Field>
        <Field Name="Job_No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Job No_</DataField>
        </Field>
        <Field Name="Job_Task_No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Job Task No_</DataField>
        </Field>
        <Field Name="JobTaskNo">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JobTaskNo</DataField>
        </Field>
        <Field Name="Task">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Task</DataField>
        </Field>
        <Field Name="Line_Type">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Line Type</DataField>
        </Field>
        <Field Name="No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>No_</DataField>
        </Field>
        <Field Name="DATE">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>DATE</DataField>
        </Field>
        <Field Name="Document_Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Document Date</DataField>
        </Field>
        <Field Name="Month_Year">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Month-Year</DataField>
        </Field>
        <Field Name="ISO_Week">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ISO-Week</DataField>
        </Field>
        <Field Name="ISO_Week_Year">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>ISO-Week-Year</DataField>
        </Field>
        <Field Name="Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Name</DataField>
        </Field>
        <Field Name="NameShort">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>NameShort</DataField>
        </Field>
        <Field Name="JPNameShort">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>JPNameShort</DataField>
        </Field>
        <Field Name="JPName">
          <rd:TypeName>System.String</rd:TypeName>
