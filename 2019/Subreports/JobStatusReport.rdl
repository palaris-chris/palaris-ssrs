  <DataSets>
    <DataSet Name="JPL_JLE">
      <Query>
        <DataSourceName>Analytics</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@JobNo_">
            <Value>=Parameters!JobNo_.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
        <CommandText>SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED;
SELECT * FROM
[Production].[vw_qry_Planned_Actual]
WHERE [Job No_] = @JobNo_</CommandText>
      </Query>
      <Fields>
        <Field Name="DB">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>DB</DataField>
        </Field>
        <Field Name="Job_No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Job No_</DataField>
        </Field>
        <Field Name="Entry">
          <Value>=IIf(Fields!Line_Type.Value=0, "Usage", "Schedule")</Value>
        </Field>
        <Field Name="Line_No_">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Line_No_</DataField>
        </Field>
        <Field Name="Job_Task_No_">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Job Task No_</DataField>
        </Field>
        <Field Name="Job_Task">
          <Value>=Fields!Job_Task_No_.Value &amp; " | " &amp; Fields!Task.Value</Value>
        </Field>
        <Field Name="ResExp">
          <Value>=IIf(Fields!Type.Value=0, "Resource", "Expense")</Value>
        </Field>
        <Field Name="Date">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>Date</DataField>
        </Field>
        <Field Name="WorkTypeSummary">
          <Value>=SWITCH
(
	Fields!Work_Type.Value = "CONTINGNCY", "CONTINGENCY",
	Fields!No_.Value = "R9998", "CONTINGENCY",
	Fields!No_.Value = "51150" OR Fields!No_.Value="51160", "SUBCONTRACTOR",
	Fields!Resource_Group_No_.Value = "SUB", "SUBCONTRACTOR-"&amp;Fields!Work_Type.Value,
	Fields!Work_Type.Value="", "EXPENSES",
	Fields!Work_Type.Value="PAY", "OTHER",
	Fields!Work_Type.Value&lt;&gt;"", Fields!Work_Type.Value
)</Value>
        </Field>
        <Field Name="Type">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Type</DataField>
        </Field>
        <Field Name="RemainingQty">
          <Value>=Fields!ScheduleQty.Value - Fields!UsageQty.Value</Value>
