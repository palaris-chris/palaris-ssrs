                              <KeepTogether>true</KeepTogether>
                              <Paragraphs>
                                <Paragraph>
                                  <TextRuns>
                                    <TextRun>
                                      <Value>=Iif((Fields!Line_Type.Value = "Contract" And Fields!Type.Value = "G/L Account") OR (Fields!Work_Type_Code.Value Like "OSA*" OR Fields!Work_Type_Code.Value Like "KM*"), 
Format(Sum(Fields!Line_Amount.Value),"F2"), 
Format(Sum(Fields!Quantity.Value),"F2") &amp;" @ "&amp; Format(Avg(Fields!Unit_Price.Value),"F2"))</Value>
                                      <Style>
